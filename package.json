{
  "name": "mapwright-spike",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite demo",
    "build:demo": "vite build demo",
    "preview": "vite preview demo --port 4173 --strictPort",
    "build:inpage": "esbuild src/inpage/index.ts --bundle --format=iife --target=es2022 --outfile=dist/inpage.js && esbuild src/inpage/agent-entry.ts --bundle --format=iife --target=es2022 --outfile=dist/inpage-agent.js",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "build:node": "esbuild src/playwright/index.ts src/playwright/tiles.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run build:inpage && npm run build:node && npm run build:types",
    "pack:local": "npm run build && npm pack --pack-destination dist"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.82",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "maplibre-gl": "^6.10.0",
    "terra-draw": "^1.34.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@maplibre/geojson-vt": "^6.1.1",
    "@maplibre/vt-pbf": "^4.3.2",
    "@types/geojson": "^7946.0.16"
  },
  "description": "Grey-box Playwright testing for canvas maps (MapLibre GL JS). Early prototype.",
  "exports": {
    ".": {
      "types": "./dist/types/playwright/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tiles": {
      "types": "./dist/types/playwright/tiles.d.ts",
      "default": "./dist/tiles.js"
    },
    "./inpage.js": "./dist/inpage.js",
    "./inpage-agent.js": "./dist/inpage-agent.js"
  },
  "files": [
    "dist/index.js",
    "dist/tiles.js",
    "dist/inpage.js",
    "dist/inpage-agent.js",
    "dist/types",
    "README.md",
    "agent/MAP_SKILL.md"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  }
}
