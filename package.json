{
  "name": "geowright",
  "license": "Apache-2.0",
  "version": "0.1.1",
  "type": "module",
  "keywords": [
    "playwright",
    "playwright-test",
    "maplibre",
    "maplibre-gl",
    "mapbox-gl",
    "mapbox",
    "map",
    "webgl",
    "canvas",
    "e2e",
    "end-to-end",
    "testing",
    "test-automation",
    "mcp"
  ],
  "scripts": {
    "dev": "vite demo",
    "build:demo": "vite build demo",
    "preview": "vite preview demo --port 4173 --strictPort",
    "build:inpage": "node scripts/build-inpage.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:compat": "playwright test -c playwright.compat.config.ts",
    "build:node": "esbuild src/playwright/index.ts src/playwright/tiles.ts --bundle --platform=node --format=esm --packages=external --outdir=dist && esbuild src/cli/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run build:inpage && npm run build:node && npm run build:types",
    "pack:local": "npm run build && npm pack --pack-destination dist",
    "prepublishOnly": "node -e \"const fs=require('fs'),m=['dist/index.js','dist/inpage.js','dist/cli.js'].filter(f=>!fs.existsSync(f));if(m.length){console.error('npm publish refused: dist/ is not built (missing '+m.join(', ')+'). Run npm run build, then read the file list of npm pack --dry-run.');process.exit(1)}\""
  },
  "devDependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.2",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@playwright/mcp": "^0.0.82",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "mapbox-gl-1": "npm:mapbox-gl@1.13.3",
    "maplibre-gl": "^6.10.0",
    "maplibre-gl-2": "npm:maplibre-gl@^2.4.0",
    "maplibre-gl-3": "npm:maplibre-gl@^3.6.2",
    "maplibre-gl-4": "npm:maplibre-gl@^4.7.1",
    "maplibre-gl-5": "npm:maplibre-gl@^5.24.0",
    "terra-draw": "^1.34.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@maplibre/geojson-vt": "^6.3.0",
    "@maplibre/vt-pbf": "^4.3.2",
    "@types/geojson": "^7946.0.16"
  },
  "description": "Grey-box end-to-end Playwright testing for canvas maps: assert on and act on MapLibre GL JS and Mapbox GL JS 1.x features with real input.",
  "author": "Shai Sinai",
  "homepage": "https://geowright.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geowright/geowright.git"
  },
  "bugs": {
    "url": "https://github.com/geowright/geowright/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "geowright": "./dist/cli.js"
  },
  "types": "./dist/types/playwright/index.d.ts",
  "typesVersions": {
    "*": {
      "tiles": [
        "dist/types/playwright/tiles.d.ts"
      ],
      "app": [
        "dist/types/app.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/playwright/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tiles": {
      "types": "./dist/types/playwright/tiles.d.ts",
      "default": "./dist/tiles.js"
    },
    "./app": {
      "types": "./dist/types/app.d.ts"
    },
    "./inpage.js": "./dist/inpage.js",
    "./inpage-agent.js": "./dist/inpage-agent.js"
  },
  "files": [
    "dist/index.js",
    "dist/tiles.js",
    "dist/cli.js",
    "dist/inpage.js",
    "dist/inpage-agent.js",
    "dist/types",
    "dist/THIRD_PARTY_LICENSES.txt",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "README.md",
    "agent/MAP_SKILL.md"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.49.0"
  }
}
